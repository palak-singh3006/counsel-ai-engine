# ==========================================
# Counsel Monorepo - Comprehensive .gitignore
# ==========================================

# Environment & Secrets (NEVER COMMIT)
.env
*.env
!.env.example
ai-engine/.env
ai-engine/*.env
!ai-engine/.env.example
backend/.env
backend/*.env
!backend/.env.example
frontend/.env
frontend/*.env
!frontend/.env.example

# Python
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
dist/
dist-ssr/
*.local
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
