# Counsel Main Backend — Environment Configuration
# Copy to .env and fill in actual values: cp .env.example .env

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Configuration (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=counsel-documents

# Counsel AI Engine (FastAPI service)
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_TIMEOUT=120000

# Optional Demo Seeding Credentials (used only by `npm run seed`)
SEED_ADVOCATE_EMAIL=advocate.demo@counsel.local
SEED_ADVOCATE_PASSWORD=CounselDemo2026!
SEED_ADVOCATE_NAME=Advocate J.K. Shukla
